{
  "components": {
    "schemas": {
      "ChatMessage": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage",
        "type": "object"
      },
      "ChatRequest": {
        "properties": {
          "max_completion_tokens": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Completion Tokens"
          },
          "max_tokens": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Tokens"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "minItems": 1,
            "title": "Messages",
            "type": "array"
          },
          "model": {
            "minLength": 1,
            "title": "Model",
            "type": "string"
          },
          "n": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "N"
          },
          "stream": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stream"
          },
          "temperature": {
            "anyOf": [
              {
                "maximum": 2.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature"
          },
          "user": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User"
          }
        },
        "required": [
          "model",
          "messages"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatResponse": {
        "properties": {
          "choices": {
            "items": {
              "$ref": "#/components/schemas/Choice"
            },
            "title": "Choices",
            "type": "array"
          },
          "created": {
            "title": "Created",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "object": {
            "const": "chat.completion",
            "title": "Object",
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "required": [
          "id",
          "object",
          "created",
          "model",
          "choices",
          "usage"
        ],
        "title": "ChatResponse",
        "type": "object"
      },
      "Choice": {
        "properties": {
          "finish_reason": {
            "enum": [
              "stop",
              "length",
              "content_filter"
            ],
            "title": "Finish Reason",
            "type": "string"
          },
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "message": {
            "$ref": "#/components/schemas/ResponseMessage"
          }
        },
        "required": [
          "index",
          "message",
          "finish_reason"
        ],
        "title": "Choice",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Param"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "message",
          "type",
          "param",
          "code"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ResponseMessage": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "role": {
            "const": "assistant",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "ResponseMessage",
        "type": "object"
      },
      "Usage": {
        "properties": {
          "completion_tokens": {
            "title": "Completion Tokens",
            "type": "integer"
          },
          "prompt_tokens": {
            "title": "Prompt Tokens",
            "type": "integer"
          },
          "total_tokens": {
            "title": "Total Tokens",
            "type": "integer"
          }
        },
        "required": [
          "prompt_tokens",
          "completion_tokens",
          "total_tokens"
        ],
        "title": "Usage",
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "description": "API key sent as 'Authorization: Bearer <key>'",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Tollgate",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/chat/completions": {
      "post": {
        "operationId": "create_chat_completion_v1_chat_completions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "x-ratelimit-limit-tokens": {
                "description": "The bucket capacity in tokens",
                "schema": {
                  "type": "integer"
                }
              },
              "x-ratelimit-remaining-tokens": {
                "description": "The balance after the limiter's decision on this request, rounded down, never below 0",
                "schema": {
                  "type": "integer"
                }
              },
              "x-ratelimit-reset-tokens": {
                "description": "Time until the bucket is full again, rounded up to whole seconds: '<s>s' below a minute, '<m>m<s>s' otherwise (0s, 45s, 6m0s)",
                "schema": {
                  "type": "string"
                }
              },
              "x-tollgate-fallbacks": {
                "description": "The number of failed attempts before the one that served the request",
                "schema": {
                  "type": "integer"
                }
              },
              "x-tollgate-provider": {
                "description": "The configured name of the provider that served the request",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid API key",
            "headers": {
              "WWW-Authenticate": {
                "description": "The authentication challenge: Bearer",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No route serves the requested model; nothing was reserved"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Token rate limit exceeded, or the request is larger than the limit",
            "headers": {
              "Retry-After": {
                "description": "Whole seconds, rounded up, until the same request can succeed. Absent when the request is larger than the limit",
                "schema": {
                  "type": "integer"
                }
              },
              "x-ratelimit-limit-tokens": {
                "description": "The bucket capacity in tokens",
                "schema": {
                  "type": "integer"
                }
              },
              "x-ratelimit-remaining-tokens": {
                "description": "The balance after the limiter's decision on this request, rounded down, never below 0",
                "schema": {
                  "type": "integer"
                }
              },
              "x-ratelimit-reset-tokens": {
                "description": "Time until the bucket is full again, rounded up to whole seconds: '<s>s' below a minute, '<m>m<s>s' otherwise (0s, 45s, 6m0s)",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The route ended without an answer: a provider failure is refunded in full, and an answer that could not be translated is charged as reserved",
            "headers": {
              "x-ratelimit-limit-tokens": {
                "description": "The bucket capacity in tokens",
                "schema": {
                  "type": "integer"
                }
              },
              "x-ratelimit-remaining-tokens": {
                "description": "The balance after the limiter's decision on this request, rounded down, never below 0",
                "schema": {
                  "type": "integer"
                }
              },
              "x-ratelimit-reset-tokens": {
                "description": "Time until the bucket is full again, rounded up to whole seconds: '<s>s' below a minute, '<m>m<s>s' otherwise (0s, 45s, 6m0s)",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Create Chat Completion"
      }
    }
  }
}
